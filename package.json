{
  "name": "hello-world-twitter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build:vendor",
    "build:vendor": "esbuild node_modules/twitter-text/dist/index.js --bundle --format=iife --global-name=twitterText --minify --outfile=public/vendor/twitter-text.js --log-level=warning",
    "dev": "node --watch src/server.js",
    "dev:fake": "LAUNCHPAD_FAKE_X=1 node --watch src/server.js",
    "start": "node src/server.js",
    "test": "npm run build:vendor && node --test"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "twitter-api-v2": "^1.27.0",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
