# Copy to $HOME/.config/hello-world-twitter/x.env (chmod 600). Never commit real values.
# The demo VM mounts that file read-only at /workspace/.env; dotenv loads it at startup.

# --- OAuth 2.0 (preferred; required for video uploads) -------------------------
# From the X Developer Console → your app → Keys and tokens → OAuth 2.0 Client ID and Client Secret.
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
# Optional seeds: an existing user Access Token / Refresh Token for the publishing account.
# When present, no browser authorization is needed. Their granted scopes are unknown until the
# first refresh; use "Connect / Reconnect X" in the app to (re)authorize with all five scopes:
# tweet.read tweet.write users.read media.write offline.access
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
# Must match the Callback URI registered in the Developer Console (User authentication settings).
X_OAUTH2_CALLBACK_URL=http://127.0.0.1:3000/auth/x/callback

# --- OAuth 1.0a (kept as a fallback for text posts only) ------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Account guard --------------------------------------------------------------
# Numeric user ID of the account that is allowed to publish (shown in the app after the
# connection check). Publishing and video replies are refused for any other account.
X_EXPECTED_ACCOUNT_ID=

# --- Storage --------------------------------------------------------------------
# Writable directory for publication.json (post/reply state), oauth2-tokens.json (0600) and
# temporary uploads. Default: ${XDG_STATE_HOME:-$HOME/.local/state}/hello-world-twitter
# The demo VM overrides it to /workspace/.data, which is bind-mounted from the host.
# LAUNCHPAD_STATE_DIR=

# --- Development only -----------------------------------------------------------
# LAUNCHPAD_FAKE_X=1 uses a mocked X connection: no network calls, no real posts.
# LAUNCHPAD_FAKE_X=
